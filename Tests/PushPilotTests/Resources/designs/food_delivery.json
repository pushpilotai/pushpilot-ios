{"name":"Food delivery","canvas":"Main.dc.html",
"fields":[{"name":"note","kind":"text","max":40},{"name":"eta","kind":"number"},{"name":"step","kind":"number"},{"name":"cur","kind":"number"},{"name":"share","kind":"number"}],
"layout":{
"lock":{"type":"layer","h":160,"bg":"#FF9F0A","items":[
 {"type":"column","at":"top_leading","h":160,"pad":[20,22,20,22],"align":"leading","items":[
  {"type":"text","text":"{{title}}","upper":true,"size":11,"weight":"heavy","tracking":0.06,"color":"#000000"},
  {"type":"spacer"},
  {"type":"row","spacing":8,"align":"baseline","items":[
   {"type":"text","text":"{{eta}}","size":64,"weight":"heavy","tracking":-0.03,"mono":true,"color":"#000000"},
   {"type":"text","text":"min","size":24,"weight":"heavy","color":"#000000"}]},
  {"type":"spacer"},
  {"type":"text","text":"{{note}}","size":13,"weight":"semibold","color":"#000000","lines":1}]},
 {"type":"column","at":"trailing","pad":[0,22,0,0],"spacing":12,"align":"center","items":[
  {"type":"layer","w":76,"h":76,"radius":38,"bg":"#000000","items":[{"type":"icon","name":"bag","color":"#FF9F0A","size":"l"}]},
  {"type":"grid","w":76,"h":6,"cols":4,"count":4,"filled":"step","gap":4,
   "tile":{"type":"shape","shape":"capsule","fill":"#000000"},
   "empty":{"type":"shape","shape":"capsule","fill":"#00000033"}}]}]},
"island":{
 "leading":{"type":"row","spacing":12,"items":[
  {"type":"layer","w":40,"h":40,"radius":20,"bg":"#2C2C2E","items":[{"type":"icon","name":"bag","color":"#FF9F0A","size":"m"}]},
  {"type":"column","spacing":2,"align":"leading","items":[
   {"type":"text","text":"{{title}}","size":15,"weight":"semibold","color":"#FFFFFF","lines":1},
   {"type":"text","text":"{{note}}","size":12,"color":"#A1A1A8","lines":1}]}]},
 "trailing":{"type":"column","spacing":2,"align":"trailing","items":[
  {"type":"text","text":"{{eta}}","size":28,"weight":"bold","mono":true,"color":"#FF9F0A"},
  {"type":"text","text":"min","size":11,"color":"#A1A1A8"}]},
 "center":{"type":"spacer"},
 "bottom":{"type":"column","spacing":8,"align":"leading","items":[
  {"type":"grid","h":6,"cols":4,"count":4,"filled":"step","gap":4,
   "tile":{"type":"shape","shape":"capsule","fill":"#FF9F0A"},
   "empty":{"type":"shape","shape":"capsule","fill":"#3A3A3C"}},
  {"type":"grid","h":14,"cols":4,"count":4,"filled":4,"gap":4,"labels":["Confirmed","Preparing","On the way","Delivered"],"current":"cur",
   "tile":{"type":"text","text":"{{label}}","align":"leading","size":11,"color":"#A1A1A8"},
   "current_tile":{"type":"text","text":"{{label}}","align":"leading","size":11,"weight":"semibold","color":"#FFFFFF"}}]},
 "compact_leading":{"type":"icon","name":"bag","color":"#FF9F0A"},
 "compact_trailing":{"type":"text","text":"{{eta}} min","size":14,"weight":"semibold","mono":true,"color":"#FF9F0A"},
 "minimal":{"type":"icon","name":"bag","color":"#FF9F0A"}},
"small":{"type":"row","spacing":8,"pad":10,"bg":"#FF9F0A","items":[
 {"type":"layer","w":40,"h":40,"radius":20,"bg":"#000000","items":[{"type":"icon","name":"bag","color":"#FF9F0A","size":"m"}]},
 {"type":"column","align":"leading","items":[
  {"type":"text","text":"{{title}}","size":12,"weight":"bold","color":"#000000","lines":1},
  {"type":"text","text":"{{eta}} min","size":24,"weight":"heavy","mono":true,"color":"#000000"}]}]},
"promoted":{"title":"{{title}}","text":"{{note}}","chip":"{{eta}} min",
 "progress":{"type":"progress","value":"share","segments":4,"color":"#FF9F0A"}}},
"state":{"title":"Order on the way","note":"Rider is 1.2 km away","eta":12,"step":3,"cur":2,"share":0.75}}
