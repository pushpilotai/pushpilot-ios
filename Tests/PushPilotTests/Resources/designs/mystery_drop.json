{"name":"Mystery drop","canvas":"MysteryDrop.dc.html",
"fields":[{"name":"word","kind":"text","max":8},{"name":"shown","kind":"numbers","max":8},{"name":"clue","kind":"text","max":32},{"name":"reveal","kind":"time"},{"name":"step","kind":"number"}],
"layout":{
"defs":{
"tiles":{"type":"grid","w":322,"h":40,"cols":8,"count":8,"gap":6,"labels":"{{word}}","filled":"shown",
 "tile":{"type":"text","text":"{{label}}","radius":8,"bg":"$on","border":{"color":"$edge","width":1},"size":18,"weight":"bold","color":"#FFFFFF"},
 "empty":{"type":"text","text":"?","radius":8,"bg":"$off","size":16,"weight":"semibold","color":"$q"}}},
"lock":{"type":"column","h":160,"bg":"#D48BFF","pad":[20,22,20,22],"items":[
 {"type":"row","items":[
  {"type":"text","text":"{{title}} · full reveal in","upper":true,"size":11,"weight":"heavy","tracking":0.06,"color":"#000000"},
  {"type":"timer","field":"reveal","mode":"down","size":11,"weight":"heavy","mono":true,"color":"#000000"}]},
 {"type":"spacer"},
 {"type":"use","ref":"tiles","colors":{"on":"#000000","edge":"#000000","off":"#00000026","q":"#00000099"}},
 {"type":"spacer"},
 {"type":"text","text":"{{clue}}","size":13,"weight":"semibold","color":"#000000"}]},
"island":{
 "leading":{"type":"column","items":[
  {"type":"text","text":"{{title}}","size":15,"weight":"semibold","color":"#FFFFFF"},
  {"type":"text","text":"{{clue}}","size":12,"color":"#A1A1A8"}]},
 "trailing":{"type":"column","align":"trailing","items":[
  {"type":"text","text":"Full reveal in","size":11,"color":"#A1A1A8"},
  {"type":"timer","field":"reveal","mode":"down","size":20,"weight":"bold","mono":true,"color":"#D48BFF"}]},
 "center":{"type":"spacer"},
 "bottom":{"type":"column","spacing":12,"items":[
  {"type":"use","ref":"tiles","colors":{"on":"#2C2C2E","edge":"#D48BFF","off":"#1C1C1E","q":"#8E8E93"}},
  {"type":"row","items":[
   {"type":"text","text":"A new letter with every clue","size":12,"color":"#A1A1A8"},
   {"type":"spacer"},
   {"type":"text","runs":[{"text":"Guess first","color":"#FFFFFF","weight":"semibold"},{"text":", buy first","color":"#A1A1A8"}],"size":12}]}]},
 "compact_leading":{"type":"icon","name":"lock","color":"#D48BFF"},
 "compact_trailing":{"type":"timer","field":"reveal","mode":"down","size":14,"weight":"semibold","mono":true,"color":"#D48BFF"},
 "minimal":{"type":"icon","name":"lock","color":"#D48BFF"}},
"small":{"type":"row","spacing":8,"pad":10,"bg":"#D48BFF","items":[
 {"type":"icon","name":"lock","color":"#000000","size":"l"},
 {"type":"column","items":[
  {"type":"text","text":"{{title}}","size":12,"weight":"bold","color":"#000000"},
  {"type":"text","text":"{{word}}","size":18,"weight":"heavy","tracking":0.06,"mono":true,"color":"#000000"}]}]},
"promoted":{"title":"{{title}}: {{word}}","text":"{{clue}}","chip":"Clue {{step}}",
 "timer":{"type":"timer","field":"reveal","mode":"down"}}},
