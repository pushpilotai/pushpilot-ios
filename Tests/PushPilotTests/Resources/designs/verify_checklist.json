{"name":"Verification checklist","canvas":"VerifyChecklist.dc.html",
"fields":[{"name":"done_n","kind":"number"},{"name":"share","kind":"number"},{"name":"s1","kind":"text","max":13},{"name":"s2","kind":"text","max":13},{"name":"s3","kind":"text","max":13},{"name":"cur","kind":"number"},{"name":"eta","kind":"text","max":6}],
"layout":{
"defs":{"tick":{"type":"icon","name":"check","w":22,"h":22,"radius":11,"bg":"$on","color":"$ink"}},
"lock":{"type":"row","h":160,"bg":"#0A2A5C","pad":[20,22,20,22],"spacing":10,"items":[
 {"type":"column","h":120,"items":[
  {"type":"text","text":"VERIFYING YOUR ACCOUNT","size":10,"weight":"heavy","tracking":0.05,"color":"#9CC8FF"},
  {"type":"spacer"},
  {"type":"text","text":"{{done_n}} of 3","size":54,"weight":"heavy","mono":true,"color":"#FFFFFF"},
  {"type":"spacer"},
  {"type":"text","text":"{{s3}} · about {{eta}}","size":12,"weight":"semibold","color":"#D6E6FF"}]},
 {"type":"spacer"},
 {"type":"grid","w":152,"h":114,"cols":1,"count":3,"gap":6,"filled":"done_n","current":"done_n","labels":["{{s1}}","{{s2}}","{{s3}}"],
  "tile":{"type":"row","pad":[0,10,0,10],"radius":10,"bg":"#143C7D","spacing":8,"items":[
   {"type":"use","ref":"tick","w":20,"h":20,"colors":{"on":"#4AE37A","ink":"#0A2A5C"}},
   {"type":"text","text":"{{label}}","size":13,"weight":"bold","color":"#FFFFFF"},
   {"type":"spacer"}]},
  "current_tile":{"type":"row","pad":[0,10,0,10],"radius":10,"bg":"#FFFFFF","spacing":8,"items":[
   {"type":"arc","w":20,"h":20,"value":"cur","width":3,"color":"#0A4FB8","track":"#C9D3DF"},
   {"type":"text","text":"{{label}}","size":13,"weight":"heavy","color":"#0A2A5C"},
   {"type":"spacer"}]},
  "empty":{"type":"text","text":"{{label}}","align":"leading","pad":[0,10,0,38],"radius":10,"bg":"#143C7D","size":13,"color":"#9CC8FF"}}]},
"island":{
 "leading":{"type":"layer","w":104,"h":104,"items":[
  {"type":"arc","w":99,"h":99,"value":"share","segments":3,"gap":8,"width":11.4,"cap":"butt","color":"#4DA3FF","track":"#2C2C2E"},
  {"type":"column","align":"center","items":[
   {"type":"text","text":"{{done_n}}/3","size":26,"weight":"heavy","mono":true,"color":"#FFFFFF"},
   {"type":"text","text":"verified","size":11,"color":"#A1A1A8"}]}]},
 "trailing":{"type":"grid","h":84,"cols":1,"count":3,"gap":9,"filled":"done_n","current":"done_n","labels":["{{s1}}","{{s2}}","{{s3}}"],
  "tile":{"type":"row","spacing":10,"items":[
   {"type":"use","ref":"tick","colors":{"on":"#30D158","ink":"#000000"}},
   {"type":"text","text":"{{label}}","size":14,"color":"#FFFFFF"},
   {"type":"spacer"}]},
  "current_tile":{"type":"row","spacing":10,"items":[
   {"type":"arc","w":22,"h":22,"value":"cur","width":3,"color":"#4DA3FF","track":"#2C2C2E"},
   {"type":"text","text":"{{label}}","size":14,"color":"#FFFFFF"},
   {"type":"spacer"},
   {"type":"text","text":"~{{eta}}","size":12,"weight":"bold","color":"#4DA3FF"}]}},
 "center":{"type":"spacer"},
 "bottom":{"type":"spacer"},
 "compact_leading":{"type":"icon","name":"shield","color":"#4DA3FF"},
 "compact_trailing":{"type":"text","text":"{{done_n}} of 3","size":14,"weight":"bold","color":"#4DA3FF"},
 "minimal":{"type":"icon","name":"shield","color":"#4DA3FF"}},
"small":{"type":"row","spacing":8,"pad":10,"bg":"#0A2A5C","items":[
 {"type":"icon","name":"shield","color":"#4DA3FF","size":"l"},
 {"type":"column","items":[
  {"type":"text","text":"Verifying account","size":12,"weight":"bold","color":"#9CC8FF"},
  {"type":"text","text":"{{done_n}} of 3","size":24,"weight":"heavy","mono":true,"color":"#FFFFFF"}]}]},
"promoted":{"title":"{{done_n}} of 3 checks done","text":"{{s3}} · about {{eta}}","chip":"{{done_n}}/3",
 "progress":{"type":"progress","value":"share","segments":3,"color":"#0A4FB8"}}},
